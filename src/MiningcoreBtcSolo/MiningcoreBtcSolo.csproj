<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MiningcoreBtcSolo</RootNamespace>
    <AssemblyName>MiningcoreBtcSolo</AssemblyName>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NBitcoin" Version="10.0.7" />
    <PackageReference Include="NetMQ" Version="4.0.4.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\dashboard.html" LogicalName="MiningcoreBtcSolo.Assets.dashboard.html" />
    <EmbeddedResource Include="Assets\p2p-fast-peers.html" LogicalName="MiningcoreBtcSolo.Assets.p2p-fast-peers.html" />
    <Content Include="Assets\dashboard.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\p2p-fast-peers.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
